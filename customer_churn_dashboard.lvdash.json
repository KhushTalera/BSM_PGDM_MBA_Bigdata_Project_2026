{
  "datasets": [
    {
      "name": "ca6fc970",
      "displayName": "Customer Churn Metrics",
      "config": {
        "version": "1.1",
        "source": "workspace.default.khush",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "avg_monthly_charges",
            "expr": "AVG(MonthlyCharges)",
            "displayName": "Avg Monthly Charges",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_tenure",
            "expr": "AVG(tenure)",
            "displayName": "Avg Tenure",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "churned_count",
            "expr": "COUNT(*) FILTER (WHERE Churn = 'Yes')",
            "displayName": "Churned Customers"
          },
          {
            "name": "churn_rate",
            "expr": "MEASURE(churned_count) / MEASURE(count)",
            "displayName": "Churn Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
  ],
